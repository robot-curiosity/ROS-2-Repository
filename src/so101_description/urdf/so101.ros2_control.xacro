<?xml version="1.0" encoding="utf-8"?>
<!--
  ros2_control configuration for the SO-101 arm.

  Two simulation backends, selected by the use_gazebo param:
    - false (default): mock_components/GenericSystem — loopback hardware,
      commanded positions are mirrored back as states (no physics).
    - true: gz_ros2_control/GzSystem — physics simulation in Gazebo Sim
      (Harmonic, the Jazzy pairing); also emits the <gazebo> plugin tag that
      runs the controller_manager inside the Gazebo process.
  A real Feetech STS3215 hardware interface can be added later as a third
  <hardware> alternative.

  Joint names and limits match urdf/so101_arm_macro.xacro (upstream values).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="so101_ros2_control" params="name use_gazebo:=false">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_gazebo}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:unless>
      </hardware>

      <xacro:macro name="so101_joint" params="joint_name">
        <joint name="${joint_name}">
          <command_interface name="position"/>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>

      <xacro:so101_joint joint_name="shoulder_pan"/>
      <xacro:so101_joint joint_name="shoulder_lift"/>
      <xacro:so101_joint joint_name="elbow_flex"/>
      <xacro:so101_joint joint_name="wrist_flex"/>
      <xacro:so101_joint joint_name="wrist_roll"/>
      <xacro:so101_joint joint_name="gripper"/>
    </ros2_control>

    <xacro:if value="${use_gazebo}">
      <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find so101_description)/config/so101_controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
