<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-level SO-101 description for standalone use (RViz / ros2_control demo).

  The arm is attached to a "world" link through a configurable mounting
  transform. The defaults (all zero) are placeholders; when the arm is mounted
  on the mobile chassis, either override these args or, preferably, call the
  so101_arm macro directly from the chassis xacro with the real transform.

    xacro so101.urdf.xacro mount_x:=0.1 mount_yaw:=1.5708
-->
<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="mount_x"     default="0.0"/>
  <xacro:arg name="mount_y"     default="0.0"/>
  <xacro:arg name="mount_z"     default="0.0"/>
  <xacro:arg name="mount_roll"  default="0.0"/>
  <xacro:arg name="mount_pitch" default="0.0"/>
  <xacro:arg name="mount_yaw"   default="0.0"/>
  <!-- Set to false to omit the ros2_control block (e.g. plain display use). -->
  <xacro:arg name="use_ros2_control" default="true"/>
  <!-- Set to true for Gazebo Sim: selects the gz_ros2_control hardware plugin
       and embeds the Gazebo controller_manager plugin tag. -->
  <xacro:arg name="use_gazebo" default="false"/>

  <xacro:include filename="$(find so101_description)/urdf/so101_arm_macro.xacro"/>
  <xacro:include filename="$(find so101_description)/urdf/so101.ros2_control.xacro"/>

  <link name="world"/>

  <xacro:so101_arm parent="world">
    <origin xyz="$(arg mount_x) $(arg mount_y) $(arg mount_z)"
            rpy="$(arg mount_roll) $(arg mount_pitch) $(arg mount_yaw)"/>
  </xacro:so101_arm>

  <xacro:if value="$(arg use_ros2_control)">
    <xacro:so101_ros2_control name="so101_arm" use_gazebo="$(arg use_gazebo)"/>
  </xacro:if>

</robot>
